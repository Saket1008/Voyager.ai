{
  "name": "voyager-ai",
  "version": "1.0.0",
  "description": "Voyager AI - Complete Travel Itinerary Generator with AI-powered planning",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev\" \"npm --prefix server run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix server run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.1"
  },
  "workspaces": [
    "frontend",
    "server"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "travel",
    "ai",
    "itinerary",
    "nextjs",
    "react",
    "typescript",
    "voyage",
    "trip-planning"
  ],
  "author": "Voyager AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyager-ai/voyager-ai.git"
  },
  "homepage": "https://voyager.ai",
  "bugs": {
    "url": "https://github.com/voyager-ai/voyager-ai/issues"
  }
}
