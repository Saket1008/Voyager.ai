{
  "functions": {
    "source": "server",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "frontend/dist",
    "predeploy": [
      "npm --prefix frontend install",
      "npm --prefix frontend run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}